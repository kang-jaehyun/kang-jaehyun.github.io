---
---

<div class="row">
  <!-- Thumbnail -->
  <div class="col-md-3 col-sm-4 col-12">
    <img
      src="{{ site.data.teasers[entry.abbr].img
              | prepend: '/assets/img/'
              | prepend: site.baseurl
              | prepend: site.url }}"
      class="img-fluid rounded"
      alt="{{ entry.title }} thumbnail">
  </div>

  <!-- Metadata -->
  <div class="col-md-9 col-sm-8 col-12">

    <div class="title">{{ entry.title }}</div>

    <div class="author">
      {% comment %} For very long author lists, show only the first author followed by "et al." {% endcomment %}
      {% assign max_authors = 10 %}
      {% assign n_authors = entry.author_array | size %}

      {% if n_authors > max_authors %}
        {% assign author = entry.author_array | first %}
        {% if author.last contains 'Kang' and author.first == 'Jaehyun' %}
          <em><b>{{ author.first }} {{ author.last }}</b></em>
        {% else %}
          {% assign coauthor = site.data.coauthors[author.first] %}
          {% assign url = coauthor.url %}
          {% if coauthor.last and coauthor.last != author.last %}{% assign url = false %}{% endif %}
          {% if url %}
            <a href="{{ url }}" target="_blank">{{ author.first }} {{ author.last }}</a>
          {% else %}
            {{ author.first }} {{ author.last }}
          {% endif %}
        {% endif %}
        <em>et al.</em>

      {% else %}
        {% for author in entry.author_array %}
          {% assign me = false %}
          {% if author.last contains 'Kang' and author.first == 'Jaehyun' %}
            {% assign me = true %}
          {% endif %}

          {% unless forloop.first %} , {% endunless %}

          {% if me %}
            <em><b>{{ author.first }} {{ author.last }}</b></em>
          {% else %}
            {% assign coauthor = site.data.coauthors[author.first] %}
            {% assign url = coauthor.url %}
            {% if coauthor.last and coauthor.last != author.last %}{% assign url = false %}{% endif %}
            {% if url %}
              <a href="{{ url }}" target="_blank">{{ author.first }} {{ author.last }}</a>
            {% else %}
              {{ author.first }} {{ author.last }}
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>


    <!-- Journal/Book title and date -->
    {% if entry.type == "article" %}
      <em>{{entry.journal}}</em>
    {% elsif entry.type == "inproceedings" %}
      <em>{{entry.booktitle}}</em>
    {% elsif entry.type == "workshop" %}
      <em>{{entry.booktitle}}</em>
      <br>
      <em>{{entry.maintitle}}</em>
    {% elsif entry.type == "preprint" %}
      <em> Preprint </em>
    {% endif %}
    {% if entry.type != "preprint" %}
      {% if entry.year %}
        {{entry.year}}
      {% endif %}
    {% endif %}
    {% if entry.award %}
      | <font color="#EF273E">{{ entry.award }}</font>
    {% endif %}

    <!-- Links/Buttons -->
    <div class="links">
      {% if entry.links_coming_soon == 'true' %}
        [<span class="text-muted">Coming soon</span>]
      {% endif %}
      {% if entry.arxiv %}
        [<a class="pub-link" href="https://arxiv.org/abs/{{ entry.arxiv }}">Paper</a>]
      {% endif %}
      {% if entry.project %}
        [<a class="pub-link" href="{{ entry.project }}">Project&nbsp;Page</a>]
      {% endif %}
      {% if entry.code %}
        [<a class="pub-link" href="{{ entry.code }}">Code</a>]
      {% endif %}
    </div>
  </div>
</div>
