---
layout: page
---

<div class="post">
  <header class="post-header">
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {% if page.cv_pdf %}
      <div class="pdf-container" style="height: 90vh; border: 1px solid #ddd; border-radius: 8px; overflow: hidden;">
        <iframe
          {% if page.cv_pdf contains '://' %}
            src="{{ page.cv_pdf }}"
          {% else %}
            src="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          {% endif %}
          width="100%"
          height="100%"
          style="border: none;"
        ></iframe>
      </div>
    {% else %}
      <p>No CV PDF provided.</p>
    {% endif %}
  </article>
</div>